{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Issue Tracker",
  "version": "0.1.0",
  "identifier": "com.ccl.issue-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "title": "Issue Tracker", "width": 1080, "height": 760, "minWidth": 720, "minHeight": 560, "acceptFirstMouse": true }],
    "security": { "csp": "default-src 'self' tauri: asset:; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
